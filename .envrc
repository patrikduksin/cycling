# Enter the flake dev shell; nix-direnv caches it until flake.nix, flake.lock
# or nix/ change. scripts/bootstrap.sh trusts every checkout and agent worktree.
watch_file nix/*.nix
use flake
# Per-machine settings such as CYCLING_DEVICE_HOST, never committed: one file
# for every checkout on this machine, then one for this checkout.
source_env_if_exists "${XDG_CONFIG_HOME:-$HOME/.config}/cycling/envrc"
source_env_if_exists .envrc.local
