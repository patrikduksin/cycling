use EmptyState from "exact:content"
use Today, WorkoutDetail, FuelDetail, WhyDetail from "./today.contract"

routes nav
  tab today "/"
    workout "/today/workout"
    fuel "/today/fuel"
    why "/today/why"
  tab device "/device"
    pair "/pair"
  tab wifi "/wifi"
  tab workouts "/workouts"
    ride "/workouts/ride/:id"

shape Link
  state: string
  detail: string
  name: string
  psm: number

shape Pairing
  paired: bool
  id: string

shape Outcome
  ok: bool
  text: string

shape Time
  epochAtZero: number
  utcOffset: number

shape Bike
  battery: string
  firmware: string
  storage: string
  ftp: string
  lthr: string

shape Ride
  id: string
  title: string
  subtitle: string
  power: bool
  heart: bool
  date: string
  start: string
  moving: string
  distance: string
  speed: string
  recorded: string
  file: string

shape Rides
  indexing: bool
  rides: Ride[]

shape Today
  planned: bool
  name: string
  detail: string

shape Network
  ssid: string
  secure: bool
  bars: number
  signal: string
  joined: bool

shape Wifi
  configured: bool
  ssid: string
  state: string
  ink: string
  bars: number
  signal: string
  networks: Network[]

shape Joined
  outcome: string
  ssid: string
  text: string

shape Fit
  path: string

shape Media
  prefersReducedMotion: bool

fn isOpen(s: string): bool = s == "open"
fn stateLabel(s: string): string = isOpen(s) ? "Connected" : s == "idle" ? "Not Connected" : s == "failed" ? "Failed" : "Connecting…"
fn barInk(bars: number): string = bars >= 3 ? "-exact-label" : bars == 2 ? "-exact-secondary-label" : "vana.unlit"
fn stateInk(s: string): string = isOpen(s) ? "vana.green" : s == "failed" ? "vana.red" : s == "idle" ? "-exact-secondary-label" : "vana.amber"

component Companion
  resource pairing = pairing() as shape Pairing
  resource link = link() as shape Link
  resource time = exactTime() as shape Time
  mutation connected as shape Outcome refreshes link
  mutation dropped as shape Outcome refreshes link
  mutation linked as shape Outcome refreshes pairing, link then afterLinked
  mutation unlinked as shape Outcome refreshes pairing, link
  derive open = isOpen(link.state)
  resource bike = bike() when open as shape Bike
  resource rides = rides(time.utcOffset) when open as shape Rides
  resource today = today() when open as shape Today
  resource wifi = wifi() when open as shape Wifi
  mutation scanned as shape Outcome refreshes wifi
  mutation joined as shape Joined refreshes wifi then afterJoin
  mutation forgot as shape Outcome refreshes wifi
  mutation fit as shape Fit then shareFit
  state aimed = ""
  state password = ""
  state problem = ""
  state sharing = ""
  state pasted = ""
  // The Today demo: the workout's trip to the bike computer, and a pull that replays the day.
  state sendStatus = "synced"
  state replays = 0
  state replaying = false
  state plan = "hard"
  resource media = exactViewport() as shape Media
  derive still = media.prefersReducedMotion
  derive busy = pending(scanned) or pending(joined) or pending(forgot)
  derive joinOutcome = match joined { case some(j) => j.outcome, case none => "" }
  derive joinText = match joined { case some(j) => j.text, case none => "" }
  derive fitPath = match fit { case some(f) => f.path, case none => "" }
  derive wifiNote = match failure(scanned) { case some(f) => f.message, case none => match failure(joined) { case some(f) => f.message, case none => joinOutcome == "no_internet" and not pending(joined) ? joinText : "2.4 GHz networks only" } }

  task landSync when sendStatus == "syncing"
    after(1400, syncLanded)
  task endReplay when replaying
    after(650, replayed)

  task scanOnAppear when (open and nav.tab == "wifi")
    after(1, scanNow)

  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action syncLanded
    sendStatus = "synced"
  action replay
    replaying = true
  action replayed
    replaying = false
    replays = replays + 1
  action openWorkout
    nav = push(nav, "/today/workout")
  action openWhy
    nav = push(nav, "/today/why")
  action swapEasy
    plan = "easy"
    sendStatus = "syncing"
  action swapBack
    plan = "hard"
    sendStatus = "syncing"
  action openFuel
    nav = push(nav, "/today/fuel")
  action connectNow
    send connected = connect()
  action dropNow
    send dropped = disconnect()
  action editPasted(v: string)
    pasted = v
  action pairPasted
    send linked = pair(pasted)
    pasted = ""
  action pairFrom(link: string)
    send linked = pair(link)
    nav = go(nav, "/device")
  action afterLinked
    if not failed(linked)
      connectNow()
  action unpairNow
    send unlinked = unpair()
  action reloadDevice
    refresh link
    refresh bike
  action reloadWorkouts
    refresh today
    refresh rides
  action scanNow
    if not busy
      send scanned = scan()
  action reloadWifi
    refresh wifi
    if not busy
      send scanned = scan()
  action ask(ssid: string)
    aimed = ssid
    password = ""
    showModal("join")
  action editPassword(v: string)
    password = v
  action joinNow
    send joined = join(aimed, password)
  action dropPassword
    password = ""
  action afterJoin
    password = ""
    if joinOutcome == "wrong_password"
      showModal("wrong")
    else if joinOutcome == "failed"
      problem = joinText
      showModal("problem")
  action tryAgain
    showModal("join")
  action forgetNow
    send forgot = forget()
  action openRide(id: string)
    nav = push(nav, path("ride", id))
  action shareRide(id: string, file: string)
    sharing = id
    send fit = fit(id, file)
  action shareFit
    if fitPath != ""
      share(files=[fitPath])

  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column"
                if e.name == "today"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Today" role="heading" aria-level=1 flex=1
                  scroll id=`content-${e.id}` flex=1 min-height=0 refresh=replay refreshing=replaying testId="today-view"
                    for k in [replays] key=k
                      Today(still=still, status=sendStatus, plan=plan, openWorkout=openWorkout, openFuel=openFuel, openWhy=openWhy, swapEasy=swapEasy, swapBack=swapBack)
                else if e.name == "workout"
                  header display="flex" align-items="center" padding="8px 16px"
                    text (plan == "easy" ? "Endurance, 1 h" : "Threshold 2 × 20") role="heading" aria-level=2
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    WorkoutDetail(still=still, status=sendStatus, plan=plan)
                else if e.name == "fuel"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Fuel" role="heading" aria-level=2
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    FuelDetail(still=still)
                else if e.name == "why"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Why this call" role="heading" aria-level=2
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    WhyDetail(still=still)
                else if e.name == "device"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "VANA" role="heading" aria-level=1 flex=1
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    refresh=reloadDevice refreshing=(pending(link) or pending(bike))
                    if not pairing.paired
                      section
                        header
                          text "Pair Bike Computer"
                        row
                          text "1. On the bike computer, swipe down and tap Phone." testId="pair-how"
                        row
                          text "2. Point the iPhone Camera at the code."
                        row
                          text "3. Tap the VANA link."
                      section
                        button commandfor="paste" command="show-modal" disabled=pending(linked) testId="paste-link"
                          text "Paste Link" font-size="0.8125rem"
                        footer
                          text match failure(linked) { case some(f) => f.message, case none => "" } testId="pair-error"
                    else
                      section
                        header
                          text "Bluetooth"
                        row
                          text "Status" flex=1
                          text stateLabel(link.state) color=stateInk(link.state) testId="state"
                        if link.name != ""
                          row
                            text "Name" flex=1
                            text link.name color="-exact-secondary-label" testId="name"
                      section
                        if open
                          button press=dropNow testId="disconnect"
                            text "Disconnect" color="vana.red"
                        else
                          button press=connectNow disabled=pending(connected) testId="connect"
                            text (pending(connected) ? "Connecting…" : "Connect")
                        footer
                          text match failure(connected) { case some(f) => f.message, case none => link.detail } testId="detail"
                    if open
                      section
                        header
                          text "Bike Computer"
                        row
                          text "Battery" flex=1
                          text bike.battery color="-exact-secondary-label" testId="battery"
                        row
                          text "Firmware" flex=1
                          text bike.firmware color="-exact-secondary-label" testId="firmware"
                        row
                          text "Storage" flex=1
                          text bike.storage color="-exact-secondary-label" testId="storage"
                        footer
                          text match failure(bike) { case some(f) => f.message, case none => "" } testId="bike-error"
                      section
                        header
                          text "Athlete"
                        row
                          text "FTP" flex=1
                          text bike.ftp color="-exact-secondary-label" testId="ftp"
                        row
                          text "LTHR" flex=1
                          text bike.lthr color="-exact-secondary-label" testId="lthr"
                    if pairing.paired
                      section
                        button commandfor="unpair" command="show-modal" disabled=pending(unlinked) testId="unpair"
                          text "Forget This Bike Computer" color="vana.red"
                        footer
                          text match failure(unlinked) { case some(f) => f.message, case none => `Paired with bike computer ${pairing.id}.` } testId="paired-id"
                  dialog id="paste" role="alertdialog" aria-label="Paste Pairing Link"
                    text "Paste a vanaride:// pairing link."
                    input type="url" value=pasted input=editPasted placeholder="vanaride://pair?…" aria-label="Pairing link" testId="pasted"
                    button press=pairPasted disabled=(pasted == "") commandfor="paste" command="close" testId="paste-confirm"
                      text "Pair"
                    button commandfor="paste" command="close" testId="paste-cancel"
                      text "Cancel"
                  dialog id="unpair" role="alertdialog" aria-label="Forget This Bike Computer?"
                    text "This iPhone stops connecting to it until you pair again."
                    button press=unpairNow destructive=true commandfor="unpair" command="close" testId="unpair-confirm"
                      text "Forget"
                    button commandfor="unpair" command="close" testId="unpair-cancel"
                      text "Cancel"
                else if e.name == "pair"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Pair Bike Computer" role="heading" aria-level=2
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "Bike Computer" flex=1
                        text searchParam(e, "id") color="-exact-secondary-label" testId="pair-id"
                      footer
                        text "Keep the code on the screen until this finishes. Pairing replaces any bike computer this iPhone used before, and any iPhone the bike computer knew." testId="pair-note"
                    section
                      button press=pairFrom(`vanaride://pair?id=${searchParam(e, "id")}&k=${searchParam(e, "k")}`) testId="pair-confirm"
                        text "Pair"
                else if e.name == "wifi"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Wi-Fi" role="heading" aria-level=1 flex=1
                  if not open
                    EmptyState(symbol="symbol:sf/wifi", title="Not Connected", message="Connect the bike computer on the Device tab to put it on Wi-Fi.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      refresh=reloadWifi refreshing=pending(wifi)
                      section
                        header
                          text "Current Network"
                        row gap=8 align-items="center" testId="current"
                          column flex=1 min-width=0 gap=2
                            text (wifi.configured ? wifi.ssid : "No network") color=(wifi.configured ? "-exact-label" : "-exact-secondary-label") testId="current-ssid"
                            text wifi.state font="-exact-subheadline" color=wifi.ink testId="current-state"
                          if wifi.bars > 0
                            image "symbol:sf/wifi" color=barInk(wifi.bars) aria-label=wifi.signal testId="current-signal"
                        if wifi.configured
                          button commandfor="forget" command="show-modal" disabled=busy testId="forget"
                            text "Forget This Network" color="vana.red"
                        footer
                          text match failure(forgot) { case some(f) => f.message, case none => match failure(wifi) { case some(f) => f.message, case none => "" } } testId="current-error"
                      section
                        header
                          row gap=6 align-items="center"
                            text "Networks"
                            if pending(scanned)
                              progress aria-label="Scanning" testId="scanning"
                        if wifi.networks.length == 0 and not pending(scanned)
                          row
                            text "No networks found" color="-exact-secondary-label" testId="no-networks"
                        for n, i in wifi.networks key=n.ssid
                          if n.secure
                            button press=ask(n.ssid) disabled=busy aria-label=`${n.ssid}, secured, ${n.signal}` testId=`network-${i}`
                              row gap=8 align-items="center" flex=1 min-width=0
                                if n.joined
                                  image "symbol:checkmark" color="vana.accent" font="-exact-body" aria-label="Joined" testId=`network-${i}-joined`
                                text n.ssid flex=1 min-width=0 color="-exact-label" testId=`network-${i}-ssid`
                                if pending(joined) and aimed == n.ssid
                                  progress aria-label="Joining"
                                image "symbol:sf/lock.fill" color="-exact-secondary-label" font="-exact-footnote" aria-label="Secured"
                                image "symbol:sf/wifi" color=barInk(n.bars) font="-exact-body" aria-label=n.signal
                          else
                            row gap=8 align-items="center" testId=`network-${i}`
                              column flex=1 min-width=0 gap=2
                                text n.ssid color="-exact-tertiary-label" testId=`network-${i}-ssid`
                                text "Not supported" font="-exact-footnote" color="-exact-tertiary-label" testId=`network-${i}-unsupported`
                              image "symbol:sf/wifi" color="-exact-tertiary-label" font="-exact-body" aria-label=n.signal
                        footer
                          text wifiNote testId="networks-note"
                  dialog id="join" role="alertdialog" aria-label=`Enter the password for “${aimed}”` close=dropPassword
                    input type="password" value=password input=editPassword placeholder="Password" aria-label="Password" testId="password"
                    button press=joinNow disabled=(password.length < 8) commandfor="join" command="close" testId="join-confirm"
                      text "Join"
                    button commandfor="join" command="close" testId="join-cancel"
                      text "Cancel"
                  dialog id="wrong" role="alertdialog" aria-label="Wrong Password"
                    text `The password for “${aimed}” is incorrect.` testId="wrong-text"
                    button press=tryAgain commandfor="wrong" command="close" testId="wrong-retry"
                      text "Try Again"
                    button commandfor="wrong" command="close" testId="wrong-cancel"
                      text "Cancel"
                  dialog id="problem" role="alertdialog" aria-label="Couldn’t Join Network"
                    text problem testId="problem"
                    button commandfor="problem" command="close" testId="problem-ok"
                      text "OK"
                  dialog id="forget" role="alertdialog" aria-label=`Forget “${wifi.ssid}”?`
                    text "The bike computer will stop joining this network."
                    button press=forgetNow destructive=true commandfor="forget" command="close" testId="forget-confirm"
                      text "Forget"
                    button commandfor="forget" command="close" testId="forget-cancel"
                      text "Cancel"
                else if e.name == "ride"
                  for r in rides.rides.filter(x => x.id == e.params.id) key=r.id
                    header display="flex" align-items="center" padding="8px 16px"
                      text r.title role="heading" aria-level=2
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        row
                          text "Date" flex=1
                          text r.date color="-exact-secondary-label" testId="ride-date"
                        row
                          text "Start" flex=1
                          text r.start color="-exact-secondary-label" testId="ride-start"
                        row
                          text "Moving Time" flex=1
                          text r.moving color="-exact-secondary-label" testId="ride-moving"
                        row
                          text "Distance" flex=1
                          text r.distance color="-exact-secondary-label" testId="ride-distance"
                        row
                          text "Average Speed" flex=1
                          text r.speed color="-exact-secondary-label" testId="ride-speed"
                        row
                          text "Recorded" flex=1
                          text r.recorded color="-exact-secondary-label" testId="ride-recorded"
                      section
                        if pending(fit) and sharing == r.id
                          button disabled=true testId="share-fit"
                            row gap=8 align-items="center"
                              progress aria-label="Downloading"
                              text "Downloading FIT…"
                        else
                          button press=shareRide(r.id, r.file) disabled=pending(fit) testId="share-fit"
                            row gap=8 align-items="center"
                              image "symbol:share"
                              text "Share FIT"
                        footer
                          text match failure(fit) { case some(f) => f.message, case none => "" } testId="share-error"
                else
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Workouts" role="heading" aria-level=1 flex=1
                  if not open
                    EmptyState(symbol="symbol:sf/bicycle", title="Not Connected", message="Connect the bike computer on the Device tab to see today's workout and your rides.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      refresh=reloadWorkouts refreshing=(pending(today) or pending(rides))
                      section
                        header
                          text "Today"
                        row testId="today"
                          column flex=1 min-width=0 gap=2
                            text today.name color=(today.planned ? "-exact-label" : "-exact-secondary-label") testId="today-name"
                            if today.detail != ""
                              text today.detail font="-exact-subheadline" color="-exact-secondary-label" testId="today-detail"
                        footer
                          text match failure(today) { case some(f) => f.message, case none => "" } testId="today-error"
                      section
                        header
                          text "Rides"
                        if rides.rides.length == 0 and current(rides)
                          row
                            text (rides.indexing ? "Looking for rides…" : "No rides yet") color="-exact-secondary-label" testId="no-rides"
                        for r in rides.rides key=r.id
                          button press=openRide(r.id) gap=8 align-items="center" testId=`ride-${r.id}`
                            column flex=1 min-width=0 gap=2
                              text r.title testId=`ride-${r.id}-title`
                              text r.subtitle font="-exact-subheadline" color="-exact-secondary-label" testId=`ride-${r.id}-subtitle`
                            if r.power
                              image "symbol:sf/bolt.fill" color="vana.power" font="-exact-footnote" aria-label="Power" testId=`ride-${r.id}-power`
                            if r.heart
                              image "symbol:heart-fill" color="vana.heart" font="-exact-footnote" aria-label="Heart rate" testId=`ride-${r.id}-heart`
                            image "symbol:forward-chevron"
                        footer
                          text match failure(rides) { case some(f) => f.message, case none => (rides.indexing and rides.rides.length > 0 ? "Still looking for older rides." : "") } testId="rides-error"
      row role="tablist" testId="tabs"
        button role="tab" aria-controls="panel-today" aria-selected=(nav.tab == "today") press=pick("today")
          testId="tab-today" flex=1
          image "symbol:sf/sun.max.fill"
          text "Today"
        button role="tab" aria-controls="panel-device" aria-selected=(nav.tab == "device") press=pick("device")
          testId="tab-device" flex=1
          image "symbol:sf/bicycle"
          text "Device"
        button role="tab" aria-controls="panel-wifi" aria-selected=(nav.tab == "wifi") press=pick("wifi")
          testId="tab-wifi" flex=1
          image "symbol:sf/wifi"
          text "Wi-Fi"
        button role="tab" aria-controls="panel-workouts" aria-selected=(nav.tab == "workouts") press=pick("workouts")
          testId="tab-workouts" flex=1
          image "symbol:sf/list.bullet.rectangle"
          text "Workouts"
