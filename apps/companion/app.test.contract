test "opens on Today; the device tab, not paired"
  expect state nav.tab == "today"
  expect text "workout-title" == "Threshold 2 × 20"
  tap "tab-device"
  expect state nav.tab == "device"
  expect text "pair-how" == "1. On the bike computer, swipe down and tap Phone."
  expect tree has "paste-link"
  expect tree missing "connect"
  expect tree missing "unpair"
  expect tree missing "battery"

test "paired, not connected: Connect and Forget This Bike Computer"
  tap "tab-device"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source unpair with {"ok": true, "text": "Forgot the bike computer"}
  answer source link with {"state": "idle", "detail": "", "name": "", "psm": 0}
  clock data
  expect text "state" == "Not Connected"
  expect tree has "connect"
  expect tree missing "paste-link"
  expect text "paired-id" == "Paired with bike computer c6060001."
  tap "unpair"
  clock settle
  tap "unpair-cancel"
  clock settle
  tap "unpair"
  clock settle
  tap "unpair-confirm"
  clock data
  expect text "paired-id" == "Paired with bike computer c6060001."

test "a pasted pairing link pairs and connects at once"
  tap "tab-device"
  answer source pair with {"ok": true, "text": "Paired"}
  answer source connect with {"ok": true, "text": "Connected to VANA in 840 ms"}
  tap "paste-link"
  clock settle
  type "pasted" "vanaride://pair?id=c6060001&k=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc"
  expect state pasted == "vanaride://pair?id=c6060001&k=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc"
  tap "paste-confirm"
  clock data
  expect state pasted == ""
  expect state connected.text == "Connected to VANA in 840 ms"

test "Pair on the link's screen saves the key and connects at once"
  at "/pair?id=c6060001&k=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc"
  answer source pair with {"ok": true, "text": "Paired"}
  answer source connect with {"ok": true, "text": "Connected to VANA in 840 ms"}
  clock settle
  expect text "pair-id" == "c6060001"
  expect text "pair-note" == "Keep the code on the screen until this finishes. Pairing replaces any bike computer this iPhone used before, and any iPhone the bike computer knew."
  tap "pair-confirm"
  clock data
  expect state connected.text == "Connected to VANA in 840 ms"

test "each tab opens its screen"
  tap "tab-activities"
  expect state nav.tab == "activities"
  expect tree missing "today"
  tap "tab-device"
  expect tree has "paste-link"

test "connected: the bike computer and athlete rows"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "VANA, PSM 129, 840 ms", "name": "VANA", "psm": 129}
  answer source bike with {"battery": "82%", "firmware": "0.4.1", "storage": "38 h of recording left", "ftp": "210 W", "lthr": "176 bpm"}
  clock data
  tap "tab-device"
  expect text "state" == "Connected"
  expect text "name" == "VANA"
  expect tree has "disconnect"
  expect text "battery" == "82%"
  expect text "firmware" == "0.4.1"
  expect text "storage" == "38 h of recording left"
  expect text "ftp" == "210 W"
  expect text "lthr" == "176 bpm"

test "connected: today's workout and the rides"
  time-zone "Europe/Berlin"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source today with {"planned": true, "name": "Sweet spot 3x12", "detail": "45 min · 12 steps"}
  answer source rides with {"indexing": false, "rides": [{"id": "f12-17", "title": "Tue 24 Nov, 07:12", "subtitle": "1:42:10 · 48.3 km", "power": true, "heart": false, "date": "Tue 24 Nov 2026", "start": "07:12", "moving": "1:42:10", "distance": "48.3 km", "speed": "28.4 km/h", "recorded": "GPS, Power", "file": "vana-2026-11-24-0712-ride17.fit"}, {"id": "i0-16", "title": "Ride 16", "subtitle": "15:05", "power": false, "heart": true, "date": "Unknown", "start": "Unknown", "moving": "15:05", "distance": "Not recorded", "speed": "Not recorded", "recorded": "Heart rate", "file": "vana-ride16.fit"}]}
  tap "tab-activities"
  clock data
  expect text "today-name" == "Sweet spot 3x12"
  expect text "today-detail" == "45 min · 12 steps"
  expect text "ride-f12-17-title" == "Tue 24 Nov, 07:12"
  expect text "ride-f12-17-subtitle" == "1:42:10 · 48.3 km"
  expect tree has "ride-f12-17-power"
  expect tree missing "ride-f12-17-heart"
  expect text "ride-i0-16-title" == "Ride 16"
  expect tree has "ride-i0-16-heart"
  expect tree missing "no-rides"

test "connected: no workout and no rides yet"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source today with {"planned": false, "name": "No workout today", "detail": ""}
  answer source rides with {"indexing": false, "rides": []}
  tap "tab-activities"
  clock data
  expect text "today-name" == "No workout today"
  expect tree missing "today-detail"
  expect text "no-rides" == "No rides yet"

test "a ride pushes its detail, and Share FIT downloads it"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source today with {"planned": false, "name": "No workout today", "detail": ""}
  answer source rides with {"indexing": false, "rides": [{"id": "f12-17", "title": "Tue 24 Nov, 07:12", "subtitle": "1:42:10 · 48.3 km", "power": true, "heart": false, "date": "Tue 24 Nov 2026", "start": "07:12", "moving": "1:42:10", "distance": "48.3 km", "speed": "28.4 km/h", "recorded": "GPS, Power", "file": "vana-2026-11-24-0712-ride17.fit"}]}
  answer source fit with {"path": "app:/cache/rides/vana-2026-11-24-0712-ride17.fit"}
  tap "tab-activities"
  clock data
  tap "ride-f12-17"
  clock settle
  expect text "ride-date" == "Tue 24 Nov 2026"
  expect text "ride-start" == "07:12"
  expect text "ride-moving" == "1:42:10"
  expect text "ride-distance" == "48.3 km"
  expect text "ride-speed" == "28.4 km/h"
  expect text "ride-recorded" == "GPS, Power"
  tap "share-fit"
  clock data
  expect state fitPath == "app:/cache/rides/vana-2026-11-24-0712-ride17.fit"
  expect text "share-error" == ""

test "Wi-Fi waits for a connected bike computer"
  tap "tab-device"
  clock data
  expect tree missing "open-wifi"

test "Wi-Fi: the current network and the scan"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source wifi with {"configured": true, "ssid": "home", "state": "Connected", "ink": "vana.green", "bars": 3, "signal": "Strong signal", "networks": [{"ssid": "home", "secure": true, "bars": 3, "signal": "Strong signal", "joined": true}, {"ssid": "Neighbour", "secure": true, "bars": 2, "signal": "Fair signal", "joined": false}, {"ssid": "Cafe", "secure": false, "bars": 1, "signal": "Weak signal", "joined": false}]}
  answer source scan with {"ok": true, "text": ""}
  tap "tab-device"
  clock data
  tap "open-wifi"
  clock data
  expect text "current-ssid" == "home"
  expect text "current-state" == "Connected"
  expect tree has "current-signal"
  expect tree has "forget"
  expect tree has "network-0-joined"
  expect tree missing "network-1-joined"
  expect text "network-2-unsupported" == "Not supported"
  expect text "networks-note" == "2.4 GHz networks only"
  expect tree missing "scanning"

test "Wi-Fi: a wrong password asks again"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source wifi with {"configured": true, "ssid": "home", "state": "Connected", "ink": "vana.green", "bars": 3, "signal": "Strong signal", "networks": [{"ssid": "home", "secure": true, "bars": 3, "signal": "Strong signal", "joined": true}, {"ssid": "Neighbour", "secure": true, "bars": 2, "signal": "Fair signal", "joined": false}, {"ssid": "Cafe", "secure": false, "bars": 1, "signal": "Weak signal", "joined": false}]}
  answer source scan with {"ok": true, "text": ""}
  answer source join with {"outcome": "wrong_password", "ssid": "Neighbour", "text": ""}
  tap "tab-device"
  clock data
  tap "open-wifi"
  clock data
  tap "network-1"
  clock settle
  type "password" "short"
  expect state password == "short"
  type "password" "correct horse"
  tap "join-confirm"
  clock data
  clock settle
  expect text "wrong-text" == "The password for “Neighbour” is incorrect."
  expect state password == ""
  tap "wrong-retry"
  clock settle
  tap "join-cancel"
  clock settle

test "Wi-Fi: joined with no internet says so"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source wifi with {"configured": true, "ssid": "home", "state": "Connected", "ink": "vana.green", "bars": 3, "signal": "Strong signal", "networks": [{"ssid": "home", "secure": true, "bars": 3, "signal": "Strong signal", "joined": true}, {"ssid": "Neighbour", "secure": true, "bars": 2, "signal": "Fair signal", "joined": false}, {"ssid": "Cafe", "secure": false, "bars": 1, "signal": "Weak signal", "joined": false}]}
  answer source scan with {"ok": true, "text": ""}
  answer source join with {"outcome": "no_internet", "ssid": "Neighbour", "text": "Joined, no internet"}
  tap "tab-device"
  clock data
  tap "open-wifi"
  clock data
  tap "network-1"
  clock settle
  type "password" "correct horse"
  tap "join-confirm"
  clock data
  clock settle
  expect text "networks-note" == "Joined, no internet"

test "Wi-Fi: a failed join tells why"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source wifi with {"configured": true, "ssid": "home", "state": "Connected", "ink": "vana.green", "bars": 3, "signal": "Strong signal", "networks": [{"ssid": "home", "secure": true, "bars": 3, "signal": "Strong signal", "joined": true}, {"ssid": "Neighbour", "secure": true, "bars": 2, "signal": "Fair signal", "joined": false}, {"ssid": "Cafe", "secure": false, "bars": 1, "signal": "Weak signal", "joined": false}]}
  answer source scan with {"ok": true, "text": ""}
  answer source join with {"outcome": "failed", "ssid": "Neighbour", "text": "Bike computer is busy"}
  tap "tab-device"
  clock data
  tap "open-wifi"
  clock data
  tap "network-1"
  clock settle
  type "password" "correct horse"
  tap "join-confirm"
  clock data
  clock settle
  expect text "problem" == "Bike computer is busy"
  tap "problem-ok"
  clock settle

test "Wi-Fi: forget asks first"
  answer source pairing with {"paired": true, "id": "c6060001"}
  answer source link with {"state": "open", "detail": "", "name": "VANA", "psm": 129}
  answer source wifi with {"configured": true, "ssid": "home", "state": "Connected", "ink": "vana.green", "bars": 3, "signal": "Strong signal", "networks": [{"ssid": "home", "secure": true, "bars": 3, "signal": "Strong signal", "joined": true}, {"ssid": "Neighbour", "secure": true, "bars": 2, "signal": "Fair signal", "joined": false}, {"ssid": "Cafe", "secure": false, "bars": 1, "signal": "Weak signal", "joined": false}]}
  answer source scan with {"ok": true, "text": ""}
  answer source forget with {"ok": true, "text": "Forgot the network"}
  tap "tab-device"
  clock data
  tap "open-wifi"
  clock data
  tap "forget"
  clock settle
  tap "forget-confirm"
  clock data
  expect text "current-error" == ""

test "Today names tonight's workout, already on VANA; why and fuel one tap away"
  expect text "today-date" == "Thursday, 26 Nov"
  expect text "workout-title" == "Threshold 2 × 20"
  expect text "workout-when" == "Starts 17:30 · 1 h 15"
  expect tree missing "swap"
  expect text "next-title" == "Lunch, carbs first"
  expect tree missing "item-lunch"
  tap "open-day"
  clock settle
  expect tree has "item-lunch"
  back
  clock settle
  tap "open-workout"
  clock settle
  expect text "sync-text" == "On your VANA"
  back
  clock settle
  tap "open-why"
  clock settle
  expect text "charge-value" == "82"
  back
  clock settle
  tap "open-fuel"
  clock settle
  expect tree has "meal-lunch"
