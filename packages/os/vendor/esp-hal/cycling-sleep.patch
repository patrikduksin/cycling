+    pub(crate) fn start_light_sleep_observed(&self, wakeup_triggers: WakeTriggers) {
+        let rtc = LPWR::regs();
+        rtc.reset_state()
+            .modify(|_, w| w.procpu_stat_vector_sel().set_bit());
+        rtc.wakeup_state().modify(|_, w| unsafe {
+            w.wakeup_ena().bits(wakeup_triggers.0.into())
+        });
+        rtc.slp_reject_conf().modify(|_, w| unsafe {
+            w.sleep_reject_ena().bits(u32::from(wakeup_triggers.0 & 0x7fff))
+        });
+        // Match the ESP-IDF ESP32-S3 entry: set sleep enable only. The older
+        // HAL entry also writes SLP_WAKEUP and does not wait for completion.
+        rtc.state0().modify(|_, w| w.sleep_en().set_bit());
+    }
