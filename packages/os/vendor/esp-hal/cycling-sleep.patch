+    /// Enter ESP32-S3 light sleep and capture hardware completion before clearing it.
+    ///
+    /// The default light-sleep API does not expose rejection, and the reset-based
+    /// `wakeup_cause` helper cannot report light sleep. This method retains the
+    /// CPU, digital peripherals, RAM, flash/PSRAM supply, XTAL and PLL. It neither
+    /// changes the active CPU clock nor suspends caches.
+    ///
+    /// The caller must quiesce DMA/radios, exclude concurrent register access and
+    /// prevent scheduler/interrupt execution across this call. This method does
+    /// not park another CPU or compensate the system monotonic timer for sleep.
+    /// A wake source must be configured; `timeout` uses RTC time and also bounds
+    /// a request that never reaches sleep. Timeout is not proof of completion.
+    #[cfg(esp32s3)]
+    pub fn sleep_light_with_status(
+        &mut self,
+        wake_sources: &[&dyn WakeSource],
+        timeout: Duration,
+    ) -> sleep::LightSleepStatus {
+        let mut config = RtcSleepConfig::default();
+        let mut triggers = WakeTriggers::default();
+        for source in wake_sources {
+            source.apply(self, &mut triggers, &mut config);
+        }
+        // A wake source must not turn this entry into a destructive transition.
+        config.set_xtal_fpu(true);
+        config.set_lslp_mem_inf_fpu(true);
+        config.set_deep_slp(false);
+        config.set_cpu_pd_en(false);
+        config.set_dig_peri_pd_en(false);
+        config.set_rtc_fastmem_pd_en(false);
+        config.set_rtc_slowmem_pd_en(false);
+        config.set_rtc_peri_pd_en(false);
+        config.set_vddsdio_pd_en(false);
+        config.set_modem_pd_en(false);
+        config.apply();
+
+        let rtc = LPWR::regs();
+        rtc.int_clr().write(|w| {
+            w.slp_reject().clear_bit_by_one().slp_wakeup().clear_bit_by_one()
+        });
+        let before = self.time_since_power_up().as_micros();
+        config.start_light_sleep_observed(triggers);
+        let (rejected, woke, timed_out) = loop {
+            let status = rtc.int_raw().read();
+            if status.slp_reject().bit_is_set() || status.slp_wakeup().bit_is_set() {
+                break (status.slp_reject().bit_is_set(), status.slp_wakeup().bit_is_set(), false);
+            }
+            if self.time_since_power_up().as_micros().saturating_sub(before) >= timeout.as_micros() {
+                // Cancel admission before returning. The caller must still treat
+                // this result as uncertain, rather than resuming peripheral work.
+                rtc.state0().modify(|_, w| w.sleep_en().clear_bit());
+                break (false, false, true);
+            }
+            core::hint::spin_loop();
+        };
+        let elapsed_us = self.time_since_power_up().as_micros().saturating_sub(before);
+        // This register reports light-sleep cause independently of reset reason.
+        let wakeup_cause = rtc.slp_wakeup_cause().read().wakeup_cause().bits();
+        rtc.wakeup_state().modify(|_, w| unsafe { w.wakeup_ena().bits(0) });
+        rtc.slp_timer1().modify(|_, w| w.main_timer_alarm_en().clear_bit());
+        config.finish_sleep();
+        sleep::LightSleepStatus { rejected, woke, timed_out, wakeup_cause, elapsed_us }
+    }
