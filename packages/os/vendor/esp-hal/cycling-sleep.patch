+/// ESP32-S3 light-sleep hardware evidence captured before interrupt cleanup.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LightSleepStatus {
+    /// The controller explicitly rejected sleep entry.
+    pub rejected: bool,
+    /// The controller latched a sleep wakeup event.
+    pub woke: bool,
+    /// No completion was observed within the RTC deadline.
+    pub timed_out: bool,
+    /// Raw RTC wake-source bits, meaningful when `woke` is true.
+    pub wakeup_cause: u32,
+    /// RTC microseconds across entry and return, including entry overhead.
+    pub elapsed_us: u64,
